#!/usr/bin/env python3
"""X32 Office : fenêtre d'application (WebKitGTK) pour les pages de /usr/share/x32-office.

    x32-office-app [page.html] [fichier]

La fenêtre n'ouvre QUE les pages locales : les liens http(s) partent dans le navigateur,
le réseau est bloqué pour les documents. Les fichiers s'ouvrent et s'enregistrent par les
boîtes de dialogue GTK normales.
"""
import json
import os
import subprocess
import sys

import gi

gi.require_version("Gtk", "3.0")
gi.require_version("WebKit2", "4.0")
from gi.repository import GLib, Gtk, WebKit2  # noqa: E402

APP_DIR = os.environ.get("X32_OFFICE_DIR", "/usr/share/x32-office")
PAGES = {"index.html": ("X32 Office", "x32-office"),
         "writer.html": ("Texte", "x32-writer"),
         "calc.html": ("Tableur", "x32-calc")}

page = sys.argv[1] if len(sys.argv) > 1 and sys.argv[1] in PAGES else "index.html"
open_arg = sys.argv[2] if len(sys.argv) > 2 else (
    sys.argv[1] if len(sys.argv) > 1 and sys.argv[1] not in PAGES else None)
# Un fichier .csv / .x32c passé seul ouvre le tableur ; un .html / .txt ouvre le traitement de texte
if open_arg and page == "index.html":
    low = open_arg.lower()
    page = "calc.html" if low.endswith((".csv", ".x32c")) else "writer.html"

title, icon = PAGES[page]


def js_str(s):
    return json.dumps(s, ensure_ascii=False)


class App:
    def __init__(self):
        self.win = Gtk.Window(title=title)
        self.win.set_icon_name(icon)
        self.win.set_default_size(1000, 640)
        screen = self.win.get_screen()
        if screen.get_width() <= 1100:
            self.win.maximize()
        self.win.connect("delete-event", self.on_close)

        ucm = WebKit2.UserContentManager()
        ucm.register_script_message_handler("x32")
        ucm.connect("script-message-received::x32", self.on_message)

        self.view = WebKit2.WebView.new_with_user_content_manager(ucm)
        s = self.view.get_settings()
        for name, value in (("enable_javascript", True), ("enable_plugins", False),
                            ("enable_developer_extras", False), ("enable_page_cache", False),
                            ("enable_webgl", False), ("enable_media_stream", False),
                            ("enable_html5_database", False), ("enable_java", False),
                            ("enable_smooth_scrolling", False), ("enable_back_forward_navigation_gestures", False)):
            try:
                getattr(s, "set_" + name)(value)
            except Exception:
                pass
        try:  # pas d'accélération matérielle : plus stable sur les vieux Intel (GMA)
            s.set_hardware_acceleration_policy(WebKit2.HardwareAccelerationPolicy.NEVER)
        except Exception:
            pass

        self.view.connect("decide-policy", self.on_policy)
        self.view.connect("permission-request", lambda v, r: r.deny() or True)
        self.view.connect("load-changed", self.on_load)
        self.view.connect("notify::title", lambda v, p: self.win.set_title(v.get_title() or title))
        self.view.connect("key-press-event", self.on_key)
        self.win.add(self.view)
        self.pending_open = open_arg
        self.view.load_uri("file://%s/%s" % (APP_DIR, page))
        self.win.show_all()

    # ---- navigation : uniquement les pages de l'application ----
    def on_policy(self, view, decision, ptype):
        if ptype == WebKit2.PolicyDecisionType.NAVIGATION_ACTION:
            uri = decision.get_navigation_action().get_request().get_uri()
            if uri.startswith("file://" + APP_DIR + "/") or uri.startswith("about:"):
                decision.use()
            else:
                if uri.startswith(("http://", "https://", "mailto:")):
                    subprocess.Popen(["xdg-open", uri], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                decision.ignore()
            return True
        return False

    def on_load(self, view, event):
        if event == WebKit2.LoadEvent.FINISHED and self.pending_open:
            path, self.pending_open = self.pending_open, None
            self.send_file(path)

    def send_file(self, path):
        try:
            with open(path, "rb") as f:
                text = f.read(30 * 1024 * 1024).decode("utf-8", errors="replace")
        except OSError as e:
            self.alert("Impossible d'ouvrir le fichier : %s" % e)
            return
        self.js("X32.receive(%s, %s)" % (js_str(os.path.basename(path)), js_str(text)))

    def js(self, code):
        self.view.run_javascript(code, None, None, None)

    # ---- messages de la page ----
    def on_message(self, ucm, result):
        try:
            try:
                raw = result.get_js_value().to_string()
            except AttributeError:
                raw = result.get_value().to_string()      # très vieux WebKit2GTK
            msg = json.loads(raw)
        except Exception:
            return
        action = msg.get("action")
        if action == "save":
            self.do_save(msg)
        elif action == "open":
            self.do_open(msg.get("accept", ""))
        elif action == "print":
            WebKit2.PrintOperation.new(self.view).run_dialog(self.win)
        elif action == "quit":
            self.win.close()

    def chooser(self, mode, name=None, accept=""):
        dlg = Gtk.FileChooserDialog(
            title="Enregistrer" if mode == Gtk.FileChooserAction.SAVE else "Ouvrir",
            parent=self.win, action=mode)
        dlg.add_buttons("Annuler", Gtk.ResponseType.CANCEL,
                        "Enregistrer" if mode == Gtk.FileChooserAction.SAVE else "Ouvrir", Gtk.ResponseType.OK)
        dlg.set_current_folder(os.path.expanduser("~/Documents") if os.path.isdir(
            os.path.expanduser("~/Documents")) else os.path.expanduser("~"))
        exts = [e.strip().lstrip(".") for e in accept.split(",") if e.strip()]
        if mode == Gtk.FileChooserAction.SAVE:
            dlg.set_do_overwrite_confirmation(True)
            dlg.set_current_name(name or "document")
        elif exts:
            flt = Gtk.FileFilter()
            flt.set_name("Documents (%s)" % ", ".join("." + e for e in exts))
            for e in exts:
                flt.add_pattern("*." + e)
            dlg.add_filter(flt)
            allf = Gtk.FileFilter()
            allf.set_name("Tous les fichiers")
            allf.add_pattern("*")
            dlg.add_filter(allf)
        return dlg

    def do_save(self, msg):
        dlg = self.chooser(Gtk.FileChooserAction.SAVE, msg.get("name"))
        if dlg.run() == Gtk.ResponseType.OK:
            path = dlg.get_filename()
            dlg.destroy()
            try:
                with open(path, "w", encoding="utf-8", newline="") as f:
                    f.write(msg.get("content", ""))
            except OSError as e:
                self.alert("Enregistrement impossible : %s" % e)
                return
            self.js("X32._saved(%s)" % js_str(os.path.basename(path)))
        else:
            dlg.destroy()

    def do_open(self, accept):
        dlg = self.chooser(Gtk.FileChooserAction.OPEN, None, accept)
        if dlg.run() == Gtk.ResponseType.OK:
            path = dlg.get_filename()
            dlg.destroy()
            self.send_file(path)
        else:
            dlg.destroy()

    def alert(self, text):
        d = Gtk.MessageDialog(parent=self.win, message_type=Gtk.MessageType.ERROR,
                              buttons=Gtk.ButtonsType.CLOSE, text=text)
        d.run()
        d.destroy()

    # ---- zoom ----
    def on_key(self, view, event):
        from gi.repository import Gdk
        if event.state & Gdk.ModifierType.CONTROL_MASK:
            z = view.get_zoom_level()
            if event.keyval in (Gdk.KEY_plus, Gdk.KEY_equal, Gdk.KEY_KP_Add):
                view.set_zoom_level(min(3.0, z + 0.1))
                return True
            if event.keyval in (Gdk.KEY_minus, Gdk.KEY_KP_Subtract):
                view.set_zoom_level(max(0.5, z - 0.1))
                return True
            if event.keyval in (Gdk.KEY_0, Gdk.KEY_KP_0):
                view.set_zoom_level(1.0)
                return True
        return False

    # ---- fermeture : demande confirmation si des modifications ne sont pas enregistrées ----
    def on_close(self, win, event):
        def done(view, res, _data):
            try:
                value = view.run_javascript_finish(res).get_js_value().to_boolean()
            except Exception:
                value = False
            if value:
                d = Gtk.MessageDialog(parent=self.win, message_type=Gtk.MessageType.QUESTION,
                                      buttons=Gtk.ButtonsType.NONE,
                                      text="Quitter sans enregistrer les modifications ?")
                d.add_buttons("Annuler", Gtk.ResponseType.CANCEL, "Quitter sans enregistrer", Gtk.ResponseType.OK)
                ok = d.run() == Gtk.ResponseType.OK
                d.destroy()
                if not ok:
                    return
            Gtk.main_quit()
        self.view.run_javascript("!!(window.X32 && X32.dirty)", None, done, None)
        return True


if __name__ == "__main__":
    GLib.set_prgname("x32-office")
    App()
    Gtk.main()
