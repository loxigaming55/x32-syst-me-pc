#!/bin/bash
# Mise à jour de X32 Système PC SANS réinstaller : par Wi-Fi/Ethernet (GitHub Releases)
# ou depuis une clé USB.
#
#   sudo x32-update                 Wi-Fi : mise à jour X32, puis Firefox
#   sudo x32-update --usb           clé USB : cherche x32-update-*.tar.gz sur les supports montés
#   sudo x32-update --file F.tar.gz depuis un fichier précis (F.tar.gz.sig doit être à côté)
#   x32-update --check              dit si une mise à jour existe (sans rien installer)
#   sudo x32-update --firefox       met à jour seulement Firefox
#   sudo x32-update --apt           applique aussi les mises à jour apt d'Ubuntu 18.04 (basse priorité)
#   sudo x32-update --rollback      revient à l'état avant la dernière mise à jour X32
#   options : --force (réinstalle même version) --pause (attend Entrée à la fin)
#
# Sécurité : un paquet de mise à jour n'est installé que si sa SIGNATURE correspond à la clé
# publique /etc/x32/update-pubkey.pem (voir README, « Signer les mises à jour »).
set -Eeuo pipefail

CONF=/etc/x32/update.conf
UPDATE_REPO="loxigaming55/x32-syst-me-pc"
PUBKEY=/etc/x32/update-pubkey.pem
ROOTFS="${X32_ROOTFS:-}"   # réservé aux tests : préfixe de toutes les écritures
STATE="$ROOTFS/var/lib/x32"
LOG=/var/log/x32-update.log
# shellcheck disable=SC1090
[ -r "$CONF" ] && . "$CONF"

DO_X32=1; DO_FF=1; DO_APT=0; USB=0; FILE=""; CHECK=0; ROLLBACK=0; FORCE=0; PAUSE=0
while [ $# -gt 0 ]; do
  case "$1" in
    --usb) USB=1; DO_FF=0 ;;
    --file) FILE="${2:?fichier manquant}"; DO_FF=0; shift ;;
    --check) CHECK=1 ;;
    --firefox) DO_X32=0 ;;
    --apt) DO_APT=1 ;;
    --all) ;;
    --rollback) ROLLBACK=1 ;;
    --force) FORCE=1 ;;
    --pause) PAUSE=1 ;;
    -h|--help) sed -n '2,16p' "$0"; exit 0 ;;
    *) echo "option inconnue : $1" >&2; exit 2 ;;
  esac
  shift
done

say()  { printf '\033[1;34m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m!!\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31mERREUR :\033[0m %s\n' "$*" >&2; exit 1; }
finish() { rc=$?; [ "$PAUSE" = 1 ] && { echo; read -r -p "Appuyez sur Entrée pour fermer… " _ || true; }; exit "$rc"; }
trap finish EXIT

cur_version() { tr -d '[:space:]' < "$ROOTFS/etc/x32-release" 2>/dev/null || echo 0.0.0; }
newer() { dpkg --compare-versions "$1" gt "$2"; }   # newer A B : A > B ?

dl() { wget -q --tries=3 --timeout=30 -O "$2" "$1"; }

if [ "$CHECK" = 0 ] && [ "$(id -u)" -ne 0 ] && [ -z "$ROOTFS" ]; then
  exec pkexec "$0" "$@" 2>/dev/null || die "lancez avec sudo"
fi
[ "$CHECK" = 1 ] || { mkdir -p "$STATE/backup" "$(dirname "${ROOTFS}$LOG")"; exec > >(tee -a "${ROOTFS}$LOG") 2>&1; }

# --------------------------------------------------------------- retour arrière
if [ "$ROLLBACK" = 1 ]; then
  b="$(ls -1t "$STATE"/backup/*.tar.gz 2>/dev/null | head -1 || true)"
  [ -n "$b" ] || die "aucune sauvegarde à restaurer"
  say "Restauration de $(basename "$b")"
  tar -xzf "$b" -C "${ROOTFS:-/}"
  if [ -f "${b%.tar.gz}.added" ]; then
    while IFS= read -r f; do [ -n "$f" ] && rm -f "$ROOTFS/$f"; done < "${b%.tar.gz}.added"
  fi
  old="$(basename "$b" | sed 's/-[0-9]\{8\}T[0-9]\{6\}\.tar\.gz$//')"
  echo "$old" > "$ROOTFS/etc/x32-release"
  [ -n "$ROOTFS" ] || systemctl daemon-reload || true
  say "Retour à la version $old terminé."
  exit 0
fi

# ---------------------------------------------------------------- vérification
verify() {  # verify archive signature
  [ -r "$PUBKEY" ] || die "clé publique absente ($PUBKEY) : cette ISO n'a pas été compilée avec une clé de mise à jour (voir README)."
  [ -r "$2" ] || die "signature introuvable : $2"
  openssl dgst -sha256 -verify "$PUBKEY" -signature "$2" "$1" >/dev/null 2>&1 \
    || die "SIGNATURE INVALIDE : la mise à jour est refusée."
  say "Signature valide"
}

# ----------------------------------------------------------------- application
apply_bundle() {
  local tgz="$1" work new cur rel dest ts bk
  work="$(mktemp -d)"
  # shellcheck disable=SC2064
  trap "rm -rf '$work'; finish" EXIT

  # chemins sûrs uniquement
  if tar -tzf "$tgz" | grep -Eq '(^/|(^|/)\.\.(/|$))'; then die "archive suspecte (chemins interdits)"; fi
  tar -xzf "$tgz" -C "$work" --no-same-owner
  [ -f "$work/VERSION" ] && [ -d "$work/payload" ] || die "archive invalide"

  new="$(tr -d '[:space:]' < "$work/VERSION")"; cur="$(cur_version)"
  if [ "$FORCE" = 0 ] && ! newer "$new" "$cur"; then
    say "X32 est déjà à jour (installée : $cur, proposée : $new)"; return 0
  fi
  say "Mise à jour X32 : $cur → $new"

  ts="$(date +%Y%m%dT%H%M%S)"; bk="$STATE/backup/$cur-$ts"
  ( cd "$work/payload" && find . \( -type f -o -type l \) | sed 's#^\./##' ) > "$work/files.list"
  ( while IFS= read -r rel; do [ -e "$ROOTFS/$rel" ] || [ -L "$ROOTFS/$rel" ] && echo "$rel"; done < "$work/files.list"; true ) > "$work/existing.list"
  grep -vxFf "$work/existing.list" "$work/files.list" > "$bk.added" || true
  tar -czf "$bk.tar.gz" -C "${ROOTFS:-/}" -T "$work/existing.list" 2>/dev/null || true
  # on ne garde que les 3 dernières sauvegardes
  ls -1t "$STATE"/backup/*.tar.gz 2>/dev/null | tail -n +4 | while read -r old; do rm -f "$old" "${old%.tar.gz}.added"; done

  touch "$work/CONFFILES"; [ -f "$work/CONFFILES" ] || true
  while IFS= read -r rel; do
    dest="$ROOTFS/$rel"
    if grep -qxF "$rel" "$work/CONFFILES" && [ -e "$dest" ] && ! cmp -s "$work/payload/$rel" "$dest"; then
      cp -a "$work/payload/$rel" "$dest.x32-new"
      warn "fichier de config modifié par vous conservé : $dest (nouvelle version : $dest.x32-new)"
      continue
    fi
    mkdir -p "$(dirname "$dest")"
    cp -a --remove-destination "$work/payload/$rel" "$dest"
  done < "$work/files.list"

  if [ -f "$work/post.sh" ] && [ -z "$ROOTFS" ]; then
    say "Finalisation"
    bash "$work/post.sh" || warn "le script de finalisation a signalé une erreur"
  fi
  echo "$new" > "$ROOTFS/etc/x32-release"
  say "X32 est maintenant en version $new. Redémarrez pour tout appliquer."
}

# ------------------------------------------------------------------- X32 : sources
update_from_file() {
  local f="$1"
  [ -f "$f" ] || die "introuvable : $f"
  verify "$f" "$f.sig"
  apply_bundle "$f"
}

update_from_usb() {
  local best="" bv="0" f v
  for f in /media/*/*/x32-update-*.tar.gz /media/*/x32-update-*.tar.gz \
           /run/media/*/*/x32-update-*.tar.gz /mnt/*/x32-update-*.tar.gz; do
    [ -f "$f" ] || continue
    v="$(basename "$f" | sed -E 's/^x32-update-(.*)\.tar\.gz$/\1/')"
    if [ -z "$best" ] || newer "$v" "$bv"; then best="$f"; bv="$v"; fi
  done
  [ -n "$best" ] || die "aucun fichier x32-update-*.tar.gz trouvé sur une clé USB montée (branchez-la et ouvrez-la dans le gestionnaire de fichiers)"
  say "Fichier trouvé : $best"
  update_from_file "$best"
}

update_from_network() {
  local tmp api tag bun sig cur
  tmp="$(mktemp -d)"; cur="$(cur_version)"
  api="https://api.github.com/repos/$UPDATE_REPO/releases/latest"
  say "Recherche de mises à jour ($UPDATE_REPO)"
  dl "$api" "$tmp/rel.json" || { rm -rf "$tmp"; die "impossible de joindre GitHub (êtes-vous connecté au Wi-Fi ?)"; }
  read -r tag bun sig < <(python3 - "$tmp/rel.json" <<'PY'
import json, sys
d = json.load(open(sys.argv[1]))
a = {x["name"]: x["browser_download_url"] for x in d.get("assets", [])}
b = next((n for n in a if n.startswith("x32-update-") and n.endswith(".tar.gz")), "")
print(d.get("tag_name", "").lstrip("v") or "-", a.get(b, "-"), a.get(b + ".sig", "-") if b else "-")
PY
  )
  [ "$bun" != "-" ] || { rm -rf "$tmp"; die "la dernière publication ne contient pas de paquet x32-update-*.tar.gz"; }
  if [ "$CHECK" = 1 ]; then
    if newer "$tag" "$cur"; then echo "Mise à jour disponible : $cur → $tag"; else echo "À jour ($cur)"; fi
    rm -rf "$tmp"; return 0
  fi
  if [ "$FORCE" = 0 ] && ! newer "$tag" "$cur"; then
    say "X32 est déjà à jour ($cur)"; rm -rf "$tmp"; return 0
  fi
  [ "$sig" != "-" ] || { rm -rf "$tmp"; die "paquet non signé : mise à jour refusée"; }
  say "Téléchargement de la version $tag"
  dl "$bun" "$tmp/b.tar.gz" || die "téléchargement échoué"
  dl "$sig" "$tmp/b.tar.gz.sig" || die "signature non téléchargée"
  verify "$tmp/b.tar.gz" "$tmp/b.tar.gz.sig"
  apply_bundle "$tmp/b.tar.gz"
  rm -rf "$tmp"
}

# ------------------------------------------------------------------------ main
if [ "$DO_X32" = 1 ]; then
  if [ -n "$FILE" ]; then update_from_file "$FILE"
  elif [ "$USB" = 1 ]; then update_from_usb
  else update_from_network; fi
fi

if [ "$CHECK" = 1 ]; then
  /usr/local/sbin/x32-firefox-update --check || true
  exit 0
fi

if [ "$DO_FF" = 1 ]; then
  say "Firefox"
  /usr/local/sbin/x32-firefox-update || warn "mise à jour de Firefox impossible (réseau ?)"
fi

if [ "$DO_APT" = 1 ]; then
  say "Mises à jour apt (Ubuntu 18.04 ne reçoit plus de correctifs de sécurité gratuits, sauf ESM)"
  nice -n 19 ionice -c3 apt-get update && nice -n 19 ionice -c3 apt-get -y upgrade || warn "apt a échoué"
fi

say "Terminé."
