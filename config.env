# Configuration du build « X32 Système PC »
# Chargé par build.sh. Tout peut être surchargé par une variable d'environnement
# du même nom (sauf les tableaux).

# --- ISO de départ : Lubuntu 18.04.5 LTS 32 bits (dernière Lubuntu en i386) ---
BASE_ISO_NAME="lubuntu-18.04.5-desktop-i386.iso"

# Dossiers miroirs contenant l'ISO et son fichier SHA256SUMS (essayés dans l'ordre).
BASE_ISO_BASES=(
  "https://cdimage.ubuntu.com/lubuntu/releases/bionic/release"
  "https://mirrors.mit.edu/ubuntu-cdimage/lubuntu/releases/bionic/release"
  "https://plug-mirror.rcac.purdue.edu/ubuntu-cd/lubuntu/releases/bionic/release"
  "https://ftp.funet.fi/index/Ubuntu/lubuntu/releases/bionic/release"
)

# --- ISO produite ---
OUT_PREFIX="x32-systeme-pc"
VOLID="X32_SYSTEME_PC"

# --- Compression du système live ---
# gzip : décompression la plus légère pour le processeur (ISO un peu plus grosse).
# Pour une ISO plus petite mais plus lente sur Atom : "-comp xz -b 1M"
SQUASH_OPTS="-comp gzip -b 256K"

# --- Paramètres noyau pour la session live (remplacent « quiet splash ») ---
#  - pas de splash Plymouth (économise du CPU au démarrage)
#  - mitigations=off : l'Atom N-series en ordre (in-order) n'est pas concerné
#    par Meltdown, et les protections coûtent cher sur un petit CPU
#  - zswap off : on utilise zram à la place
KERNEL_PARAMS_LIVE="quiet mitigations=off zswap.enabled=0"

# --- Firefox ---
# Dernière branche ESR de Mozilla qui existe encore en 32 bits (voir README)
export X32_FIREFOX_ESR_MAJOR=140
export X32_FIREFOX_LANG=fr
